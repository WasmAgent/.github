{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wasmagent-external-validation/v1",
  "title": "WasmAgent external validation ledger",
  "description": "Machine-readable ledger of external evidence about WasmAgent artifacts. The normative enforcement lives in scripts/validate-external-evidence.py (EXT-01..07); this schema documents the contract.",
  "type": "object",
  "required": ["schema_version", "last_reviewed", "records"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "last_reviewed": { "type": "string", "format": "date" },
    "_comment": { "type": "string" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "venue",
        "evidence_type",
        "state",
        "claim_ceiling",
        "prohibited_claims",
        "anchors",
        "limitations"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EXT-[A-Z0-9]+-\\d{4}$"
        },
        "subject": { "type": "string", "minLength": 1 },
        "venue": {
          "type": "object",
          "required": ["org", "repo"],
          "properties": {
            "org": { "type": "string", "minLength": 1 },
            "repo": { "type": "string", "minLength": 1 },
            "issue": { "type": "integer", "minimum": 1 },
            "pull_request": { "type": "integer", "minimum": 1 },
            "affiliation": { "type": "string" }
          }
        },
        "evidence_type": {
          "enum": [
            "external_observation",
            "independent_layered_run",
            "independent_native_run",
            "upstream_contribution",
            "published_reference",
            "formal_certification"
          ]
        },
        "state": {
          "enum": [
            "proposed",
            "open",
            "pending_merge",
            "merged",
            "superseded",
            "withdrawn"
          ]
        },
        "tested_target": { "type": "string" },
        "layers": { "type": "object" },
        "result_summary": { "type": "object" },
        "claim_ceiling": { "type": "string", "minLength": 20 },
        "prohibited_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        },
        "anchors": {
          "type": "object",
          "required": ["issue_url"],
          "properties": {
            "issue_url": { "type": "string", "pattern": "^https://" },
            "pr_url": { "type": "string", "pattern": "^https://" },
            "publication_url": { "type": "string", "pattern": "^https://" }
          }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 10 }
        },
        "certifying_body": { "type": "string" },
        "certificate_id": { "type": "string" },
        "certificate_url": { "type": "string", "pattern": "^https://" },
        "scope": { "type": "string" },
        "valid_from": { "type": "string", "format": "date" },
        "valid_until": { "type": "string", "format": "date" }
      }
    }
  }
}
